{
  "name": "destino",
  "config": {
    "connector.class": "io.debezium.connector.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "connection.url": "jdbc:postgresql://postgres-destino:5432/dw",
    "connection.username": "postgres",
    "connection.password": "${env:PG_DESTINO_SENHA}",
    "insert.mode": "upsert",
    "delete.enabled": "true",
    "primary.key.mode": "record_key",
    "schema.evolution": "basic",
    "use.time.zone": "UTC",
    "topics.regex": "app\\.public\\..*"
  }
}
