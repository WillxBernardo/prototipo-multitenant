# Copie para .env (não versionado) e troque as senhas: cp .env.exemplo .env
# O docker compose lê o .env automaticamente. Para os scripts e o dbt, exporte-o no shell:
#   set -a; . ./.env; set +a

PG_ORIGEM_SENHA=troque-esta-senha
PG_DESTINO_SENHA=troque-esta-senha

# Portas publicadas no host (só em 127.0.0.1). Opcionais: estes são os valores padrão.
PG_ORIGEM_PORTA=15432
PG_DESTINO_PORTA=15433
CONNECT_PORTA=8083
